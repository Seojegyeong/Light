{
  "manifest_version": 3,
  "name": "pinkkok",
  "version": "0.1.0",
  "description": "경제 뉴스 금융 용어 자동 하이라이트 Chrome 확장 프로그램",
  "icons": {
    "16": "icons/logo-16.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "pinkkok"
  }
}
